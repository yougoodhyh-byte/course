<view class="page">
  <view class="card form">
    <text class="label">课程名称</text>
    <input class="input" value="{{courseName}}" bindinput="onName" placeholder="输入课程名称"/>
    <text class="label">地点</text>
    <input class="input" value="{{location}}" bindinput="onLocation" placeholder="例如：东海岸-E教338"/>
    <text class="label">星期</text>
    <picker range="{{days}}" value="{{dayIndex}}" bindchange="onDay"><view class="picker">{{days[dayIndex]}}</view></picker>
    <text class="label">上课周次（可多选）</text>
    <view class="chips"><view wx:for="{{weeks}}" wx:key="n" class="chip {{item.selected?'selected':''}}" data-i="{{index}}" bindtap="toggleWeek">{{item.n}}</view></view>
    <text class="label">上课节次（可多选）</text>
    <view class="chips"><view wx:for="{{slots}}" wx:key="code" class="chip slot {{item.selected?'selected':''}}" data-i="{{index}}" bindtap="toggleSlot"><text>{{item.label}}</text><text class="small">{{item.start}}</text></view></view>
    <text class="label">上课进度</text>
    <textarea class="textarea" value="{{progress}}" bindinput="onProgress" placeholder="可留空"/>
    <text class="label">课程颜色</text>
    <view class="colors"><view wx:for="{{colors}}" wx:key="*" class="color {{item===color?'active':''}}" style="background:{{item}}" data-color="{{item}}" bindtap="pickColor"></view></view>
  </view>
  <view class="actions">
    <button wx:if="{{editing}}" class="btn btn-danger" bindtap="remove">删除原安排</button>
    <button class="btn btn-primary" bindtap="save" loading="{{saving}}">保存</button>
  </view>
</view>
