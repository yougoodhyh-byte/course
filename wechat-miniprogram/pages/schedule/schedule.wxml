<view class="page">
  <view class="row space heading">
    <view><view class="h1">教学课程时间</view><view class="muted">{{weekLabel}}</view></view>
    <button class="btn btn-primary add" bindtap="addCourse">添加课程</button>
  </view>

  <view class="reminder card" wx:for="{{reminders}}" wx:key="id">
    <button class="close" data-id="{{item.id}}" bindtap="dismissReminder">×</button>
    <view class="reminder-kicker">今日重要提醒</view>
    <view class="reminder-title">{{item.title}}</view>
    <view class="reminder-desc" wx:if="{{item.description}}">{{item.description}}</view>
    <button class="done" data-id="{{item.id}}" bindtap="completeReminder"><view class="box"></view>已完成</button>
  </view>

  <view class="weekbar card">
    <button class="arrow" bindtap="prevWeek">‹</button>
    <button class="current" bindtap="goCurrent">第 {{week}} 周</button>
    <button class="arrow" bindtap="nextWeek">›</button>
  </view>

  <view wx:if="{{items.length}}">
    <view class="course card" wx:for="{{items}}" wx:key="key" data-ids="{{item.idsText}}" bindtap="editCourse">
      <view class="stripe" style="background:{{item.color}}"></view>
      <view class="course-main">
        <view class="row space"><view class="course-name">{{item.name}}</view><view class="tag">{{item.dayName}}</view></view>
        <view class="time">{{item.dateText}} · {{item.time}}</view>
        <view class="location">{{item.location || '地点待填写'}}</view>
        <view class="progress" wx:if="{{item.progress}}">进度：{{item.progress}}</view>
      </view>
    </view>
  </view>
  <view class="empty card" wx:else>这一周暂无课程安排</view>

  <button class="logout" bindtap="logout">退出账号</button>
</view>
