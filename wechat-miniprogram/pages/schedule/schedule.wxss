.heading{margin-bottom:22rpx}.add{width:auto;margin:0}.reminder{position:relative;border:2rpx dashed #df3342;padding:24rpx 78rpx 22rpx 24rpx;margin-bottom:18rpx;background:#fffafa}
.close{position:absolute;right:12rpx;top:8rpx;background:transparent;color:#b6424e;font-size:40rpx;line-height:52rpx;width:56rpx;height:56rpx;padding:0}.close::after{border:0}
.reminder-kicker{font-size:20rpx;color:#b06870}.reminder-title{font-size:30rpx;font-weight:650;color:#614e69;margin:5rpx 0}.reminder-desc{font-size:23rpx;color:#8d7a96;line-height:1.6}.done{margin:18rpx 0 0;padding:0;background:transparent;color:#5b6f88;font-size:23rpx;display:flex;align-items:center;gap:12rpx;justify-content:flex-start}.done::after{border:0}.box{width:26rpx;height:26rpx;border:3rpx solid #3478d4;border-radius:5rpx}
.weekbar{display:flex;align-items:center;justify-content:center;margin-bottom:22rpx;padding:12rpx}.arrow,.current{background:transparent;color:#6d5879}.arrow{font-size:46rpx;width:100rpx}.current{font-size:27rpx;font-weight:650}.arrow::after,.current::after{border:0}
.course{display:flex;overflow:hidden;margin-bottom:16rpx}.stripe{width:10rpx;flex:none}.course-main{padding:22rpx 24rpx;flex:1;min-width:0}.course-name{font-size:29rpx;font-weight:650;color:#5f4d69}.time{margin-top:8rpx;color:#7f6e89;font-size:23rpx}.location,.progress{margin-top:7rpx;color:#9988a2;font-size:22rpx}.progress{background:#faf7fc;padding:10rpx 12rpx;border-radius:10rpx}
.logout{margin-top:50rpx;background:transparent;color:#a08daa;font-size:22rpx}.logout::after{border:0}
