<view class="page">
  <view class="h1">其他服务</view>

  <view class="fold card">
    <view class="fold-head" data-key="bus" bindtap="toggle"><view><view class="fold-title">校车时刻表</view><view class="muted">{{busRoute}}</view></view><text>{{openSection==='bus'?'⌃':'⌄'}}</text></view>
    <view class="fold-body" wx:if="{{openSection==='bus'}}">
      <text class="label">方向</text><picker range="{{directionLabels}}" value="{{directionIndex}}" bindchange="directionChange"><view class="select">{{directionLabels[directionIndex]}}</view></picker>
      <text class="label">查看方式</text><picker range="{{modeLabels}}" value="{{modeIndex}}" bindchange="modeChange"><view class="select">{{modeLabels[modeIndex]}}</view></picker>
      <block wx:if="{{modeIndex===0}}"><text class="label">日期</text><picker mode="date" value="{{busDate}}" bindchange="busDateChange"><view class="select">{{busDate}}</view></picker></block>
      <view class="bus-row" wx:for="{{busRows}}" wx:key="id"><view class="bus-time">{{item.departure}}</view><view class="bus-main"><view>{{item.from}} → {{item.to}}</view><view class="muted">{{item.arrivalText}} · {{item.trip}}</view></view></view>
      <view class="empty" wx:if="{{!busRows.length}}">没有符合条件的班次</view>
    </view>
  </view>

  <view class="fold card">
    <view class="fold-head" data-key="attendance" bindtap="toggle"><view><view class="fold-title">考勤表</view><view class="muted">计量经济学、数字经济专业认知、微观经济学</view></view><text>{{openSection==='attendance'?'⌃':'⌄'}}</text></view>
    <view class="fold-body" wx:if="{{openSection==='attendance'}}">
      <view class="attendance-course" wx:for="{{attendanceCourses}}" wx:key="id" data-id="{{item.id}}" bindtap="openAttendance"><view><view class="course-name">{{item.name}}</view><view class="muted">{{item.students}}名学生 · {{item.dates}}个上课日期</view></view><text>›</text></view>
      <button class="btn export-all" bindtap="exportAllAttendance">导出全部考勤</button>
    </view>
  </view>

  <view class="fold card">
    <view class="fold-head" data-key="calendar" bindtap="toggle"><view><view class="fold-title">校历</view><view class="muted">{{calendarSummary}}</view></view><text>{{openSection==='calendar'?'⌃':'⌄'}}</text></view>
    <view class="fold-body" wx:if="{{openSection==='calendar'}}">
      <view class="term-switch"><view class="{{term==='fall'?'active':''}}" data-term="fall" bindtap="setTerm">秋季</view><view class="{{term==='spring'?'active':''}}" data-term="spring" bindtap="setTerm">春季</view></view>
      <view class="event" wx:for="{{calendarEvents}}" wx:key="index"><view class="event-date">{{item.date}}</view><view><view class="event-title">{{item.title}}</view><view class="muted">{{item.detail}}</view></view></view>
      <view class="week-grid"><view class="week {{item.current?'current':''}}" wx:for="{{calendarWeeks}}" wx:key="week"><view>第{{item.week}}周</view><view class="muted">{{item.range}}</view><view class="phase">{{item.phase}}</view></view></view>
      <view class="section-title times-title">上课时间</view><view class="times"><view wx:for="{{classTimes}}" wx:key="code">{{item.code}} · {{item.start}}–{{item.end}}</view></view>
      <view class="section-title times-title">考试时间</view><view class="times"><view wx:for="{{examTimes}}" wx:key="name">{{item.name}} · {{item.start}}–{{item.end}}</view></view>
    </view>
  </view>
</view>
