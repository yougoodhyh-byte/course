.fold{margin-top:16rpx;overflow:hidden}.fold-head{padding:24rpx;display:flex;align-items:center;justify-content:space-between}.fold-title{font-size:29rpx;font-weight:650;color:#65516f}.fold-body{border-top:1rpx solid #eee5f3;padding:22rpx}.select{height:72rpx;line-height:72rpx;border:1rpx solid #dfd4e7;border-radius:14rpx;padding:0 18rpx;background:#fff}
.bus-row{display:flex;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #eee7f2}.bus-time{font-size:30rpx;font-weight:700;color:#6956d9}.bus-main{font-size:24rpx;color:#5f5068}
.attendance-course{display:flex;justify-content:space-between;align-items:center;padding:20rpx 6rpx;border-bottom:1rpx solid #eee7f2}.course-name{font-size:27rpx;font-weight:650;color:#65516f}.export-all{margin-top:22rpx;width:100%}
.term-switch{display:flex;background:#f3eef6;border-radius:14rpx;padding:5rpx;margin-bottom:18rpx}.term-switch view{flex:1;text-align:center;padding:14rpx;color:#8b7994;border-radius:11rpx}.term-switch .active{background:#fff;color:#6956d9;font-weight:650}
.event{display:grid;grid-template-columns:180rpx 1fr;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid #eee7f2}.event-date{font-size:21rpx;color:#897793}.event-title{font-size:25rpx;font-weight:650;color:#62506c}
.week-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx;margin-top:18rpx}.week{border:1rpx solid #e9dff0;border-radius:14rpx;padding:14rpx;font-size:22rpx}.week.current{border-color:#6956d9;background:#faf7ff}.phase{margin-top:6rpx;color:#6956d9;font-size:19rpx}.times-title{margin-top:28rpx}.times{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx;margin-top:12rpx}.times view{background:#faf7fc;border-radius:12rpx;padding:12rpx;font-size:21rpx;color:#796882}
