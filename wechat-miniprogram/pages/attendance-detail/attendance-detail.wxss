.attendance-page{padding-bottom:220rpx}.top{margin-bottom:16rpx}.search{margin-bottom:18rpx}.table-scroll{width:100%;background:#fff;border:1rpx solid #e9dff0;border-radius:18rpx;white-space:nowrap}.table{display:inline-block;min-width:100%}.tr{display:flex;min-height:76rpx;border-bottom:1rpx solid #eee6f2}.tr:last-child{border-bottom:0}.cell{width:118rpx;flex:none;display:flex;align-items:center;justify-content:center;border-right:1rpx solid #eee6f2;background:#fff;font-size:22rpx;padding:8rpx}.header .cell{background:#faf7fc;color:#75637e;font-weight:650}.name{width:156rpx;justify-content:flex-start}.sticky{position:sticky;left:0;z-index:5;background:#fff!important}.header .sticky{background:#faf7fc!important}.student-no{width:190rpx;justify-content:flex-start}.date{flex-direction:column}.week{display:block;font-size:17rpx;color:#a18eab;margin-top:3rpx}.status{font-size:26rpx;font-weight:650}.state-present{color:#16834b;background:#f2fbf5}.state-absent{color:#d22638;background:#fff4f4}.state-neutral{color:#222}.active-col{box-shadow:inset 3rpx 0 #df3342,inset -3rpx 0 #df3342;background:#fffafa!important}.header .active-col{box-shadow:inset 3rpx 0 #df3342,inset -3rpx 0 #df3342,inset 0 3rpx #df3342}
.del{margin-left:auto;background:transparent;color:#b7aabb;padding:0;width:42rpx;font-size:28rpx}.del::after{border:0}.bottom-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:18rpx}
