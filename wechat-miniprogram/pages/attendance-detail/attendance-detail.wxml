<view class="page attendance-page">
  <view class="row space top"><view><view class="h1">{{courseName}}</view><view class="muted">{{students.length}}名学生 · {{dates.length}}个上课日期</view></view></view>
  <input class="input search" value="{{query}}" bindinput="search" placeholder="检索姓名或学号"/>
  <scroll-view class="table-scroll" scroll-x enhanced scroll-into-view="{{scrollIntoView}}">
    <view class="table">
      <view class="tr header">
        <view class="cell name sticky">姓名</view>
        <view id="col-{{item.key}}" class="cell date {{item.active?'active-col':''}}" wx:for="{{dates}}" wx:key="key"><text>{{item.text}}</text><text class="week">第{{item.week}}周{{item.active?' · 上课中':''}}</text></view>
        <view class="cell student-no">学号</view>
      </view>
      <view class="tr" wx:for="{{students}}" wx:key="id" wx:for-item="student">
        <view class="cell name sticky"><text>{{student.name}}</text><button class="del" data-id="{{student.id}}" bindtap="deleteStudent">×</button></view>
        <view class="cell status {{cell.active?'active-col':''}} {{cell.className}}" wx:for="{{student.cells}}" wx:key="date" wx:for-item="cell" data-student="{{student.id}}" data-date="{{cell.date}}" bindtap="changeStatus">{{cell.value}}</view>
        <view class="cell student-no">{{student.studentNo}}</view>
      </view>
    </view>
  </scroll-view>
  <view class="bottom-actions">
    <button class="btn" bindtap="exportCourse">导出考勤</button>
    <button class="btn btn-primary" bindtap="replaceExcel">{{hasStudents?'替换 Excel':'上传 Excel'}}</button>
  </view>
</view>
