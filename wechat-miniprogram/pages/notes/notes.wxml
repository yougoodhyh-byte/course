<view class="page">
  <view class="row space head"><view><view class="h1">重要事项</view><view class="muted">{{summary}}</view></view><button class="btn btn-primary add" bindtap="add">添加事项</button></view>
  <view class="filters card"><view wx:for="{{filters}}" wx:key="key" class="filter {{filter===item.key?'active':''}}" data-key="{{item.key}}" bindtap="setFilter">{{item.text}}</view></view>
  <view class="note card {{item.done?'done':''}}" wx:for="{{notes}}" wx:key="id">
    <button class="check" data-id="{{item.id}}" bindtap="toggleDone">{{item.done?'✓':'○'}}</button>
    <view class="note-main" data-id="{{item.id}}" bindtap="edit"><view class="note-title">{{item.title}}</view><view class="date">{{item.dateText}}</view><view class="desc" wx:if="{{item.description}}">{{item.description}}</view></view>
  </view>
  <view class="empty card" wx:if="{{!notes.length}}">暂无事项</view>
  <view class="overlay" wx:if="{{editing}}">
    <view class="editor card">
      <view class="row space"><view class="section-title">{{editId?'编辑事项':'添加事项'}}</view><button class="x" bindtap="close">×</button></view>
      <text class="label">标题</text><input class="input" value="{{form.title}}" data-k="title" bindinput="formInput"/>
      <text class="label">日期</text><picker mode="date" value="{{form.date}}" bindchange="dateChange"><view class="input date-picker">{{form.date||'选择日期'}}</view></picker>
      <text class="label">描述</text><textarea class="textarea" value="{{form.description}}" data-k="description" bindinput="formInput"/>
      <view class="editor-actions"><button wx:if="{{editId}}" class="btn btn-danger" bindtap="remove">删除</button><button class="btn btn-primary" bindtap="save">保存</button></view>
    </view>
  </view>
</view>
