.head{margin-bottom:20rpx}.add{width:auto;margin:0}.filters{display:flex;padding:8rpx;margin-bottom:18rpx}.filter{flex:1;text-align:center;padding:16rpx;border-radius:16rpx;color:#8c7c96;font-size:23rpx}.filter.active{background:#f0eafb;color:#6956d9;font-weight:650}
.note{display:flex;align-items:flex-start;padding:20rpx;margin-bottom:14rpx}.check{width:64rpx;background:transparent;color:#6956d9;font-size:34rpx;padding:0}.check::after,.x::after{border:0}.note-main{flex:1}.note-title{font-size:28rpx;font-weight:650;color:#604e69}.date{font-size:20rpx;color:#9e8ba8;margin-top:4rpx}.desc{font-size:23rpx;color:#8c7a95;margin-top:8rpx;line-height:1.6}.done{opacity:.55}.done .note-title{text-decoration:line-through}
.overlay{position:fixed;inset:0;background:rgba(43,31,49,.28);z-index:20;display:flex;align-items:flex-end}.editor{width:100%;padding:28rpx;border-radius:30rpx 30rpx 0 0}.x{background:transparent;color:#9a87a5;font-size:40rpx;width:60rpx;padding:0}.date-picker{line-height:78rpx;color:#7e6c88}.editor-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:24rpx}.editor-actions .btn:only-child{grid-column:1/-1}
