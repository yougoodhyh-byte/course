page{background:#f7f4fa;color:#332b38;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}
view,text,button,input,textarea,picker,scroll-view{box-sizing:border-box}
.page{padding:28rpx 24rpx 180rpx}.card{background:#fff;border:1rpx solid #e9dff0;border-radius:24rpx;box-shadow:0 8rpx 28rpx rgba(75,51,90,.045)}
.h1{font-size:42rpx;font-weight:700;color:#5d496a;margin-bottom:8rpx}.muted{color:#9a8aa4;font-size:22rpx;line-height:1.7}
.btn{height:72rpx;line-height:72rpx;border-radius:18rpx;font-size:26rpx;padding:0 28rpx;background:#fff;color:#685476;border:1rpx solid #dfd4e6}
.btn::after{border:0}.btn-primary{background:#6956d9;color:#fff;border-color:#6956d9}.btn-danger{color:#be4250;border-color:#ecc5ca;background:#fff}
.row{display:flex;align-items:center}.space{justify-content:space-between}.gap{gap:16rpx}.tag{font-size:20rpx;padding:5rpx 12rpx;border-radius:999rpx;background:#f2edf6;color:#846f92}
.input{height:78rpx;border:1rpx solid #dfd4e7;border-radius:16rpx;background:#fff;padding:0 22rpx;font-size:27rpx}.textarea{min-height:150rpx;border:1rpx solid #dfd4e7;border-radius:16rpx;background:#fff;padding:18rpx 22rpx;font-size:27rpx;width:100%}
.label{display:block;color:#75667e;font-size:23rpx;margin:20rpx 0 10rpx}.section-title{font-size:30rpx;font-weight:650;color:#655370}
.empty{text-align:center;padding:70rpx 24rpx;color:#a08eaa}
